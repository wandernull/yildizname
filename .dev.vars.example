# Copy to .dev.vars (gitignored) for local `wrangler dev`.
# For production, use `wrangler secret put <NAME>` per variable.

ANTHROPIC_API_KEY="sk-ant-..."
ELEVENLABS_API_KEY="sk_..."

# Stripe — use TEST keys (sk_test_*) for local dev; the production
# Worker uses LIVE keys (sk_live_*) loaded via `wrangler secret put`.
# Webhook secret comes from the `stripe listen` CLI command:
#   stripe listen --forward-to http://localhost:8787/api/stripe/webhook
# The CLI prints a `whsec_...` value once on start — paste it here.
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# HTTP Basic Auth credentials for the /admin backoffice (analytics
# dashboard at https://yildizna.me/admin). For production, set via
# `npx wrangler secret put ADMIN_USER` and `npx wrangler secret put ADMIN_PASS`.
ADMIN_USER="admin"
ADMIN_PASS="change-me-locally"

# Resend API key for outbound email sent AS destek@yildizna.me (e.g. promo
# / win-back codes from the admin Ops page). The yildizna.me domain is
# verified in Resend (DKIM on the root); inbound destek@/support@ still
# route through Cloudflare Email Routing. Resend keys are not test/prod-
# scoped, so the same key works locally and in prod. Production:
#   npx wrangler secret put RESEND_API_KEY
RESEND_API_KEY="re_..."
